#!/bin/bash
#
# Pick one of a repository's worktrees in Raycast, then run a script there.
#
# Usage: worktree-run <repository> <script>
#
# Opens Run Script from the worktrees extension narrowed to that repository, with
# the script as the action. Raycast asks before a deeplink starts a command;
# allow it always and the question goes away.

set -eu

if [ $# -ne 2 ]; then
  echo "usage: worktree-run <repository> <script>" >&2
  exit 64
fi

if [ ! -d "$1" ]; then
  echo "worktree-run: no such directory: $1" >&2
  exit 66
fi

repo=$(cd "$1" && pwd)

# JavaScript for Automation ships with macOS, so no jq or python is needed to encode.
context=$(osascript -l JavaScript -e '
  function run(argv) {
    return encodeURIComponent(JSON.stringify({ repo: argv[0], script: argv[1] }));
  }' "$repo" "$2")

open "raycast://extensions/andreas/worktrees/run-script?launchContext=$context"
